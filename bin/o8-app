#!/bin/sh
# Open the built orchestr8.app, or run it in dev mode if it has not been built.
root=$(cd "$(dirname "$0")/.." && pwd)
app="$root/src-tauri/target/release/bundle/macos/orchestr8.app"
if [ -d "$app" ]; then exec open "$app"; fi
export PATH=/opt/homebrew/opt/rustup/bin:$PATH
cd "$root" && exec npm run app:dev
