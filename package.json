{
  "name": "tiller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tl": "./bin/tl",
    "tld": "./bin/tld",
    "tl-app": "./bin/tl-app"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "daemon": "tsx src/daemon/index.ts",
    "tl": "tsx src/daemon/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
